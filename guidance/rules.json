  "rules": [
    {
      "id": "intent",
      "label": "保留目标",
      "instruction": "保持用户真正要交付的结果、任务对象与范围；不添加新任务。 方法指导可自然改述，手写限制和精确字面量仍保留；来源分类使用结构字段，不按标题截断。",
      "avoid": [
        "不以该规则添加用户未要求的任务或流程"
      ],
      "signals": [
        "修改对象",
        "最终结果"
      ],
      "sourceIds": [
        "anthropic-context",
        "openai-optimizer",
        "sentry-optimizer"
      ],
      "regressionIds": [
        "Q01"
      ]
    },
    {
      "id": "constraints",
      "label": "保留约束",
      "instruction": "保留明确禁止、正面授权、必须保留项、预算、先后顺序和批准前置条件；礼貌前缀不改变要求，条件与动作不拆散；不删改或反转授权，不新增格式与语言要求；区分真实指令、疑问、认知不确定与描述性提及。 保留可以/建议/必须/禁止/不必的任务强度及其对象与条件；方法卡的可选建议不自动加入必做任务。 保留每项要求的作用对象与条件；话题前置不自动改变强度，覆盖检查范围不等于覆盖文件，修改建议不等于执行修改。 明确绑定同一动作与对象，不能把临时或指定对象扩大为全部；保留可选原句后再加要求标题，也不能把可选事项变成必做。",
      "avoid": [
        "不以该规则添加用户未要求的任务或流程"
      ],
      "signals": [
        "权限",
        "预算",
        "保留"
      ],
      "sourceIds": [
        "anthropic-context",
        "openai-optimizer",
        "sentry-optimizer"
      ],
      "regressionIds": [
        "Q02"
      ]
    },
    {
      "id": "format",
      "label": "保留输出合同",
      "instruction": "保留目标输出格式、语言、受众和语气；区分输入格式与输出格式，不强套章节。",
      "avoid": [
        "不以该规则添加用户未要求的任务或流程"
      ],

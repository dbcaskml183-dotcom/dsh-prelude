{
  "name": "dsh-prompt-coach",
  "version": "0.4.27",
  "description": "Prelude — DeepSeek Harness (DSH) 提示词优化与改写助手，提供方法卡、局部补句和原稿对照。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <=0.2.1-rc.5 || 0.2.2-rc.1",
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs && node tools/manifest.mjs --write",
    "test": "node tools/test.mjs",
    "lint": "eslint .",
    "verify": "node tools/manifest.mjs",
    "verify:source": "node tools/source-manifest.mjs"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "eslint": "10.13.0"
  },
  "files": [
    "index.mjs",
    "client.js",
    "methods.json",
    "sources.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "MANIFEST.sha256",
    "bundles.json",
    "bin/storage-doctor.mjs",
    "docs/compatibility.md",
    "docs/operations.md",
    "docs/architecture.md",
    "CHANGELOG.md",
    "docs/rewrite-workflow.md",
    "guidance/rules.json",
    "README.en.md",
    "docs/installation.md",
    "docs/installation.en.md",
    "docs/assets/method-library.jpg",
    "docs/catalog.md",
    "docs/method-sources.md",
    "docs/quickstart.md",
    "docs/privacy.md",
    "docs/faq.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "VERIFICATION.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.2 <=0.2.1-rc.5 || 0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.5 || 3.19.0"
  },
  "displayName": "Prelude",
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "prompt-engineering",
    "prompt-editor",
    "prelude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbcaskml183-dotcom/dsh-prelude.git"
  },
  "homepage": "",
  "bugs": {
    "url": "https://github.com/dbcaskml183-dotcom/dsh-prelude/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
